ANTHROPIC_API_KEY=your_api_key_here
SESSION_SECRET=change_this_to_a_random_string
PORT=3000
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_chosen_voice_id_here
# Optional override (code defaults to eleven_flash_v2_5 if unset):
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Neon Postgres connection string for stock tracking. Use the "dev" branch's pooled string
# locally and the "production" branch's in Render. Never commit a real value. Optional: if
# it is unset the server starts normally with stock tracking off (every item in stock).
DATABASE_URL=postgresql://user:password@host/dbname

# Admin login (D4). Leave both commented out and admin is off: every /admin path is a 404.
# Setting only one of them, or a weak secret, stops the server from starting. Generate both
# with: node scripts/hash-admin-password.js --new-secret
# ADMIN_PASSWORD_HASH=scrypt:32768:8:1:salt:hash
# ADMIN_SESSION_SECRET=change_this_to_a_long_random_string_of_at_least_32_characters

# Number of proxies between visitors and this app, used to find each visitor's real IP for
# the per-IP rate limits. Leave unset for 1 (local dev, ngrok). On Render the confirmed
# value is 3 (client, Cloudflare, Render internal). A whole number from 1 to 5; anything
# else stops startup.
# TRUST_PROXY_HOPS=1

# Public pages' Content Security Policy (D7). Leave unset or "report-only" (the default): the
# policy is only reported in the browser Console and cannot break the site. "enforce" makes
# browsers block violations; it is planned for after the live site has been checked and has
# shown a clean Console for about 3 days. Anything else stops startup.
# PUBLIC_CSP_MODE=report-only
